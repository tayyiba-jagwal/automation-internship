    {
      "parameters": {
        "jsCode": "// Read the raw input from previous node\nconst inputData = $input.first().json;\nlet rawText = \"\";\n\n// 1. Check for nested Gemini/LLM parts output\nif (inputData.parts && inputData.parts[0] && inputData.parts[0].text) {\n  rawText = inputData.parts[0].text;\n} else if (typeof inputData.text === 'string') {\n  rawText = inputData.text;\n} else if (typeof inputData.text === 'object') {\n  rawText = JSON.stringify(inputData.text);\n} else {\n  rawText = JSON.stringify(inputData);\n}\n\n// 2. Strip markdown codeblock backticks if present\nrawText = rawText.replace(/```json|```/gi, \"\").trim();\n\nlet category = \"General\";\n\n// 3. Attempt JSON parse\ntry {\n  const parsed = JSON.parse(rawText);\n  if (parsed.category) {\n    category = parsed.category.toString().trim();\n  } else if (typeof parsed === 'string') {\n    category = parsed.trim();\n  }\n} catch (e) {\n  // 4. Fallback string keyword detection\n  const upper = rawText.toUpperCase();\n  if (upper.includes(\"SALES\")) category = \"Sales\";\n  else if (upper.includes(\"SUPPORT\")) category = \"Support\";\n  else if (upper.includes(\"COMPLAINT\")) category = \"Complaint\";\n  else if (upper.includes(\"INVOICE\")) category = \"Invoice\";\n  else if (upper.includes(\"SPAM\")) category = \"Spam\";\n}\n\n// Capitalize exact casing (e.g., \"Sales\", \"Support\")\ncategory = category.charAt(0).toUpperCase() + category.slice(1).toLowerCase();\n\nreturn [{\n  \"category\": \"Invoice\"\n}];"
      },
