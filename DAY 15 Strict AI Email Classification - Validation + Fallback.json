    {
      "parameters": {
        "jsCode": "const input = $json;\n\nreturn [{\n  json: {\n    ...input,\n   aiResponse: {\n  category: \"Support\",\n  priority: \"Medium\",\n  sentiment: \"Neutral\",\n  department: \"Customer Support\",\n  summary: \"Customer reports a delayed delivery and asks about a discount.\"\n}\n  }\n}];"
      },
      "id": "218680e2-49a1-45eb-a0ee-14d8cedf6b59",
      "name": "AI Analysis (Test)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $json.aiResponse;\nconst allowed = {\n  category: [\"Sales\", \"Support\", \"Complaint\"],\n  priority: [\"Low\", \"Medium\", \"High\"],\n  sentiment: [\"Positive\", \"Neutral\", \"Negative\"],\n  department: [\"Sales\", \"Customer Support\", \"Management\"]\n};\n\nconst required = [\"category\", \"priority\", \"sentiment\", \"department\", \"summary\"];\nconst keys = Object.keys(data || {});\nconst errors = [];\n\nfor (const field of required) {\n  if (!(field in (data || {}))) errors.push(`Missing field: ${field}`);\n}\n\nfor (const field of [\"category\", \"priority\", \"sentiment\", \"department\"]) {\n  if (data?.[field] !== undefined && !allowed[field].includes(data[field])) {\n    errors.push(`Invalid ${field}: ${data[field]}`);\n  }\n}\n\nif (typeof data?.summary !== \"string\" || !data.summary.trim()) {\n  errors.push(\"summary must be a non-empty string\");\n}\n\nconst unexpected = keys.filter(k => !required.includes(k));\nif (unexpected.length) errors.push(`Unexpected fields: ${unexpected.join(\", \")}`);\n\nreturn [{\n  json: {\n    ...$json,\n    valid: errors.length === 0,\n    validationErrors: errors\n  }\n}];"
      },
      "id": "e6e31baf-f98c-487a-b3b9-e3f3af32f259",
      "name": "Validate JSON Contract",
