{
  "name": "AI Customer Support Triage System",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support-ticket",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "d8f511d5-ba9c-4e52-b516-20ccb5f348e8",
      "name": "Customer Message Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1728,
        240
      ],
      "webhookId": "support-triage-inbound"
    },
    {
      "parameters": {
        "jsCode": "// Normalize incoming payload so downstream nodes have a stable shape\nconst body = $input.first().json.body || $input.first().json;\n\nconst message = body.message || body.text || '';\nconst customerId = body.customer_id || body.customerId || 'unknown';\nconst customerEmail = body.email || body.customer_email || '';\nconst channel = body.channel || 'web_form';\nconst ticketId = 'TCK-' + Date.now() + '-' + Math.floor(Math.random() * 1000);\n\nif (!message || message.trim().length === 0) {\n  throw new Error('No message content provided in webhook payload');\n}\n\nreturn [{\n  json: {\n    ticket_id: ticketId,\n    customer_id: customerId,\n    customer_email: customerEmail,\n    channel: channel,\n    message: message,\n    received_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "73f004bc-d141-440d-bab2-87a6f30f2075",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1504,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { prompt: `You are a customer support triage assistant. Analyze the customer message and respond with ONLY a single valid JSON object (no markdown fences, no commentary) matching this schema:\n\n{\n  \"category\": \"billing | technical | account | complaint | refund_request | feature_request | general_inquiry | other\",\n  \"priority\": \"low | medium | high | urgent\",\n  \"sentiment\": \"positive | neutral | negative | very_negative\",\n  \"department\": \"billing | technical_support | customer_success | sales | management\",\n  \"summary\": \"one to two sentence summary of the issue\",\n  \"suggested_response\": \"a short, empathetic draft reply the agent can send or lightly edit\",\n  \"urgent_flag\": true or false\n}\n\nRules:\n- priority = urgent only for service outages affecting the customer's ability to use the product, security/data breach concerns, legal threats, or explicit safety issues.\n- priority = high for billing disputes over $100, repeated unresolved issues, or angry/very_negative sentiment with a real complaint.\n- sentiment reflects the customer's emotional tone, not the severity of the issue.\n- department billing handles category billing and refund_request; technical_support handles category technical; customer_success handles account and general_inquiry; sales handles feature_request; management handles complaint when sentiment is very_negative.\n- urgent_flag must be true if and only if priority is \"urgent\".\n- Output strictly valid JSON. Do not wrap it in code fences.` } }];"
      },
      "id": "e758a0a3-bd5d-437f-b0c6-5103a57e5183",
      "name": "Load System Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1280,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "// Dynamic input extraction (Handles both direct string or Gemini response structure)\nconst item = $input.first().json;\nlet rawText = item.text || item.content?.parts?.[0]?.text || item.output || \"\";\n\n// Clean markdown fences if Gemini wraps JSON in ```json ... ```\nrawText = rawText.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\nlet parsed = {};\nlet parse_error = false;\n\ntry {\n  parsed = JSON.parse(rawText);\n} catch (e) {\n  parse_error = true;\n}\n\n// Pull the original ticket data back in - it was set in \"Normalize Input\" but\n// this node otherwise only returns the AI's output, dropping ticket_id,\n// customer_id, customer_email, channel, message, received_at.\nconst original = $('Normalize Input').first().json;\n\nreturn [\n  {\n    json: {\n      ticket_id: original.ticket_id,\n      customer_id: original.customer_id,\n      customer_email: original.customer_email,\n      channel: original.channel,\n      message: original.message,\n      received_at: original.received_at,\n      category: parsed.category || \"general_inquiry\",\n      priority: parsed.priority || \"medium\",\n      sentiment: parsed.sentiment || \"neutral\",\n      department: parsed.department || \"customer_success\",\n      summary: parsed.summary || \"\",\n      suggested_response: parsed.suggested_response || \"\",\n      urgent_flag: !!parsed.urgent_flag,\n      parse_error: parse_error\n    }\n  }\n];"
      },
      "id": "ec16a1d2-775e-46b0-8559-1df95e96ba3a",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -464,
        240
      ]
    },
