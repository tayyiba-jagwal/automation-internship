  "nodes": [
    {
      "parameters": {
        "jsCode": "const lead = $json.body || $json;\n\nconst requiredFields = [\n  \"Name\",\n  \"Email\",\n  \"Company\",\n  \"Service\",\n  \"Budget\"\n];\n\nconst missingFields = requiredFields.filter(\n  field => lead[field] === undefined || lead[field] === null || lead[field] === \"\"\n);\n\nreturn {\n  json: {\n    ...lead,\n    isValid: missingFields.length === 0,\n    missingFields\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2272,
        32
      ],
      "id": "ffcd3a95-b120-4c94-896e-36c5b8e72ab7",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const lead = $json;\n\nreturn {\n  json: {\n    name: String(lead.Name).trim(),\n    email: String(lead.Email).trim().toLowerCase(),\n    company: String(lead.Company).trim(),\n    service: String(lead.Service).trim(),\n    budget: Number(lead.Budget)\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1856,
        -80
      ],
      "id": "78de377e-0b0e-4966-9405-688ad0aa89c5",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const lead = $json;\n\nlet budgetScore = 0;\nlet serviceScore = 0;\n\nif (lead.budget >= 100000) {\n  budgetScore = 50;\n} else if (lead.budget >= 50000) {\n  budgetScore = 30;\n} else {\n  budgetScore = 10;\n}\n\nconst service = lead.service.toLowerCase();\n\nif (\n  service.includes(\"web\") ||\n  service.includes(\"mobile\") ||\n  service.includes(\"ai\") ||\n  service.includes(\"automation\")\n) {\n  serviceScore = 30;\n} else {\n  serviceScore = 10;\n}\n\nconst totalScore = budgetScore + serviceScore;\n\nreturn {\n  json: {\n    ...lead,\n    budgetScore,\n    serviceScore,\n    totalScore\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1648,
        -80
      ],
      "id": "e2611cab-30d7-47d3-b90c-0df6c87fbfdc",
      "name": "Code in JavaScript2"
    },
    {
      "parameters": {
        "jsCode": "const score = $json.totalScore;\n\nlet priority;\n\nif (score >= 80) {\n  priority = \"High\";\n} else if (score >= 50) {\n  priority = \"Medium\";\n} else {\n  priority = \"Low\";\n}\n\nreturn {\n  json: {\n    ...$json,\n    priority\n  }\n};"
      },
